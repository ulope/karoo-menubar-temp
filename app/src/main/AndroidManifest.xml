<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- KarooSystemService binds to the Karoo app store service. -->
    <queries>
        <package android:name="io.hammerhead.appstore" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_statusbar_temp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatusBarTemp">

        <!-- Settings and setup screen, launched from the Karoo app/extension menu. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads the ride app's top status row (ride time, battery, clock) to place and
             show/hide the temperature, and draws it as an accessibility overlay.
             It only observes; it never performs actions. -->
        <service
            android:name=".StatusBarTempService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Registers the app as a Karoo extension. -->
        <service
            android:name=".StatusBarTempExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="${karooManifestUrl}" />
    </application>
</manifest>
